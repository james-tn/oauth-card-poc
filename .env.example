# ---- Inputs you set before running the provisioning scripts ----

# Azure target
TENANT_ID=00000000-0000-0000-0000-000000000000
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOCATION=eastus2
RESOURCE_GROUP=oauth-card-poc-rg

# Bot identity & infra naming
BOT_DISPLAY_NAME="OAuth POC"
BOT_AAD_APP_NAME=oauth-poc-bot-app
BOT_HANDLE=oauthpocbot01            # 4-42 chars, [a-zA-Z0-9_-], must be unique in your subscription
OAUTH_CONNECTION_NAME=github-as-generic
BOT_PORT=8080
CAE_ENV_NAME=oauth-poc-cae-env
CAE_APP_NAME=oauthpocbotapp         # 2-32 chars, lowercase + hyphen
CAE_LOCATION=eastus2

# ---- IdP (default: GitHub) -------------------------------------------------
# Register a GitHub OAuth App at https://github.com/settings/developers and
# paste its Client ID + Client Secret here. The Authorization callback URL on
# the GitHub side MUST be: https://token.botframework.com/.auth/web/redirect
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_AUTHORIZE_URL=https://github.com/login/oauth/authorize
IDP_TOKEN_URL=https://github.com/login/oauth/access_token
IDP_SCOPES=read:user

# To use a different IdP (Auth0, Okta, your own STS, Entra in generic mode,
# Google, ...), override the four IDP_* values above with your provider's
# authorize/token URLs, scopes, client id, and client secret. The script in
# infra/04-create-oauth-connection.sh is IdP-agnostic.

# ---- Filled in by infra/01,03,05 scripts ----
BOT_APP_ID=
BOT_APP_SECRET=
BOT_APP_OBJECT_ID=
BOT_URL=
BOT_NAME=
MANIFEST_ID=
