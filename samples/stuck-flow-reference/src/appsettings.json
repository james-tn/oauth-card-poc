{
  "TokenValidation": {
    "Enabled": true,
    "Audiences": [ "" ],
    "TenantId": ""
  },

  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,

    "UserAuthorization": {
      "DefaultHandlerName": "auto",
      "AutoSignIn": true,
      "Handlers": {
        "auto": {
          "Settings": {
            "AzureBotOAuthConnectionName": "github-new-generic",
            "Title": "Sign in to GitHub",
            "Text": "Sign in"
          }
        }
      }
    }
  },

  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/common",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": [ "https://api.botframework.com/.default" ]
      }
    }
  },

  "ConnectionsMap": [
    { "ServiceUrl": "*", "Connection": "ServiceConnection" }
  ],

  "OAuthConnectionName": "",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
